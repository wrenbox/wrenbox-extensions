{
  "manifest_version": 3,
  "name": "Huefinch – Color Blind Filter & Color Identifier",
  "short_name": "Huefinch",
  "version": "0.0.0",
  "description": "Helps color-blind eyes tell colors apart on any website and names any color on screen. Private: nothing leaves your browser.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Huefinch",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "toggle-huefinch": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Turn Huefinch on or off"
    }
  }
}
