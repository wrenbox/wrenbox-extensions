{
  "manifest_version": 3,
  "name": "Bowerline – PDF & Web Highlighter",
  "short_name": "Bowerline",
  "version": "0.0.0",
  "description": "Highlight web pages and PDFs, add notes, export to Obsidian, Notion or Markdown. Private: no account, nothing leaves your browser.",
  "minimum_chrome_version": "140",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bowerline",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Highlight the selection (and turn Bowerline on for this page)"
    }
  }
}
